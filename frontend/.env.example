# Vite only exposes vars prefixed VITE_ to browser code — anything else in
# a frontend .env is silently invisible to import.meta.env, by design (so a
# backend secret accidentally placed here can't leak into the bundle).
#
# This is NOT a secret itself: Vite inlines it into the built JS at build
# time, so it is plainly visible to anyone who opens devtools. It is just
# where the backend lives, not something to protect.
#
#   cp .env.example .env
VITE_API_URL=http://localhost:8000
